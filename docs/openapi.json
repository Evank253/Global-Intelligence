{
  "openapi": "3.0.3",
  "info": {
    "title": "KCN Intelligence OS v4 - Global Network API",
    "description": "Modular, multi-layer intelligence framework with verifiable reasoning traces, sub-0.5ms bus latency, and unalterable 6-Question Accountability Passports.",
    "version": "4.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Enterprise Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Retrieve Kernel Diagnostics & System Telemetry",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "System operational status summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/query": {
      "post": {
        "summary": "Process Natural Language Query through Multi-Agent Pipeline",
        "operationId": "processQuery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": { "type": "string", "example": "Analyze climate mitigation strategies using cellular resilience models." },
                  "context": { "type": "object" }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reasoning verdict with 6-question accountability passport",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents": {
      "get": {
        "summary": "List Active Agent Swarms and Domain Specialists",
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "List of registered agent swarm entities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/history": {
      "get": {
        "summary": "Query System Event Bus Telemetry Logs",
        "operationId": "getHistory",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50 }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of event bus telemetry records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "summary": "Submit Human Feedback Score into Learning Loop",
        "operationId": "submitFeedback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session_id": { "type": "string" },
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "comments": { "type": "string" }
                },
                "required": ["session_id", "rating"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback confirmation payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}